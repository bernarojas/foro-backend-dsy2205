# Datos para docker-compose.oracle-cloud.yml. Copiar a ".env" y completar (".env" no se sube a git).

# Nombre del servicio de la Autonomous Database, tal como aparece en wallet/tnsnames.ora.
# Ejemplo: si la base se llama "forodb", el servicio es forodb_high
DB_SERVICIO=forodb_high

# Usuario creado con database/01_crear_usuario.sql
DB_USER=FORO
DB_PASSWORD=

# Clave con la que se firma el token de sesión: la misma para los tres microservicios (32 caracteres o más).
JWT_SECRET=

# Opcional: carpeta del wallet descomprimido (por defecto ./wallet) y puerto del FrontEnd (por defecto 8084).
# WALLET_DIR=./wallet
# FRONTEND_PORT=8084
